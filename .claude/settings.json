{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.forge/hooks/protected-paths.mjs\" --stdin-key tool_input.file_path --stdin-key tool_input.notebook_path --refuse-exit 2"
          }
        ]
      }
    ]
  }
}
